# Copy to backend/.env for local development. Never commit the real .env.

# PostgreSQL connection string. Leave unset locally to use a SQLite file (citexa.db).
# On Render, use Supabase's "Session pooler" URI (IPv4, port 5432), e.g.
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Set to true once DATABASE_URL works, so a database outage stops the app instead of losing data
REQUIRE_DATABASE=

# Signs login tokens. Must be a long random value in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# AI key for the FAQ and schema generators (the audit and competitor checks don't need one).
# Free option: a Google AI Studio (Gemini) key with the two settings below. Note: on Gemini's free
# tier, Google may use submitted content to improve its products.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash

# Razorpay (see Razorpay dashboard > Settings > API Keys and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# IDs of the monthly plans created in Razorpay (Subscriptions > Plans): ₹2,499 Starter and ₹7,499 Monitoring
RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_MONTHLY_PLAN_ID=

# Comma-separated list of allowed frontend origins (optional)
ALLOWED_ORIGINS=
